{
  "runs": 3,
  "timeoutMs": 180000,
  "endpoints": [
    {
      "id": "candidate",
      "role": "candidate",
      "protocol": "responses",
      "url": "https://YOUR-PROXY.example/v1/responses",
      "model": "YOUR-EXACT-MODEL-ID",
      "keyEnv": "CANDIDATE_API_KEY",
      "parameters": { "max_output_tokens": 16000 }
    },
    {
      "id": "baseline",
      "role": "baseline",
      "protocol": "responses",
      "url": "https://api.openai.com/v1/responses",
      "model": "YOUR-EXACT-MODEL-ID",
      "keyEnv": "BASELINE_API_KEY",
      "parameters": { "max_output_tokens": 16000 }
    }
  ]
}
